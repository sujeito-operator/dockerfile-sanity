{
  "name": "dockerfile-sanity",
  "displayName": "Dockerfile Sanity — cache, root and secret checks with no setup",
  "description": "Flags the Dockerfile mistakes that cost you: COPY ordering that busts your build cache, containers running as root, secrets baked into layers, unpinned base images and apt bloat. Pure JavaScript, no hadolint or Docker install required.",
  "version": "0.1.1",
  "publisher": "sujeito-operator",
  "license": "MIT",
  "sponsor": {
    "url": "https://github.com/sujeito-operator/pilot"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sujeito-operator/dockerfile-sanity.git"
  },
  "bugs": {
    "url": "https://github.com/sujeito-operator/dockerfile-sanity/issues"
  },
  "homepage": "https://github.com/sujeito-operator/dockerfile-sanity#readme",
  "bin": {
    "dockerfile-sanity": "./cli.js"
  },
  "files": [
    "cli.js",
    "analyze.js",
    "extension.js",
    "action.yml",
    "icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test.js && node test-cli.js"
  },
  "engines": {
    "vscode": "^1.75.0",
    "node": ">=18"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "dockerfile",
    "docker",
    "lint",
    "linter",
    "container",
    "devops",
    "security",
    "hadolint",
    "build cache",
    "cli",
    "ci",
    "lint-dockerfile",
    "container-security",
    "zero-dependency"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dockerfileSanity.scanWorkspace",
        "title": "Dockerfile Sanity: Scan workspace"
      }
    ],
    "configuration": {
      "title": "Dockerfile Sanity",
      "properties": {
        "dockerfileSanity.disabledRules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Rule ids to suppress, e.g. runs-as-root, cache-order, apt-recommends."
        }
      }
    }
  },
  "icon": "icon.png"
}
